# Bound — Environment Variables
# Copy this file to .env and adjust if needed. Vite loads .env automatically.

# VITE_API_URL: Base URL for Bound backend API
# Both http://localhost:4000 and http://localhost:4000/api work (backend mounts both prefixes).
VITE_API_URL=http://localhost:4000

# GROQ_API_KEY: optional, BACKEND ONLY (never use a VITE_ prefix — that would
# ship the key in the browser bundle). Enables POST /ai/interpret, which turns
# free text into a task proposal draft. Without it the endpoint returns 501
# and the app keeps working on its built-in parser. The LLM never authorizes.
# GROQ_API_KEY=
# GROQ_MODEL: optional Groq model id (default: llama-3.3-70b-versatile).
# GROQ_MODEL=llama-3.3-70b-versatile
